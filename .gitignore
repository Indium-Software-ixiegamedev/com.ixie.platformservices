# =========================================================================
# Unity Package Specific Ignores
# =========================================================================

# Ignore the local test/example Unity projects used during development
# (Adjust these folder names if your sample project uses a different name)
/[Tt]est[Pp]roject/
/[Ee]xample[Pp]roject/
/[Ss]amples~/

# Ignore Package Manager runtime caches generated locally
.Modules/

# =========================================================================
# Standard Unity & Build Ignores (If test projects are tracked inside)
# =========================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/

# Asset Garbage
*.pre
*.unitypackage

# =========================================================================
# IDE and OS Generated Files
# =========================================================================
# Visual Studio / Rider / VS Code
.vs/
.idea/
*.sln
*.csproj
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svclog
*.com.apple.devalchemy.StructureEditor.runtime-infos

# OS-specific
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
